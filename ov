# --- Exercise 4.3 ⭐⭐⭐ — Collatz Conjecture ---
start_number = 27
n = start_number
steps = 0
while n != 1:
    if n % 2 == 0:
        n = n // 2
    else:
        n = 3 * n + 1
    steps += 1
    print(f"Step {steps}: {n}")
print(f"Reached 1 in {steps} steps")


