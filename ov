# --- Exercise 8.1 ⭐⭐⭐ — Student Report Generator ---
students = [
    {"name": "Alice", "scores": [85, 92, 78, 90]},
    {"name": "Bob", "scores": [90, 88, 95, 87]},
    {"name": "Charlie", "scores": [72, 68, 80, 65]},
    {"name": "Diana", "scores": [95, 97, 93, 99]},
]


def letter_grade(avg):
    if avg >= 90:
        return "A"
    elif avg >= 80:
        return "B"
    elif avg >= 70:
        return "C"
    elif avg >= 60:
        return "D"
    return "F"


report_lines = ["=== STUDENT REPORT ==="]
for student in students:
    scores = student["scores"]
    avg = sum(scores) / len(scores)
    grade = letter_grade(avg)
    report_lines.append(f"{student['name']:<10} | Avg: {avg:.2f} | Grade: {grade}")
report_lines.append("=====================")

report_text = "\n".join(report_lines)
with open("student_report.txt", "w") as f:
    f.write(report_text + "\n")
print(report_text)


# --- Exercise 8.2 ⭐⭐⭐ — Word Frequency Counter ---
sample_text = """
Python is a great programming language. Python is easy to learn.
Many developers love Python because Python is versatile.
Learning Python opens many doors. Python is fun and Python is powerful.
"""
with open("sample.txt", "w") as f:
    f.write(sample_text)

with open("sample.txt", "r") as f:
    text = f.read()

text = text.lower()
for mark in ".,!?;:\"'()":
    text = text.replace(mark, "")

counts = {}
for word in text.split():
    counts[word] = counts.get(word, 0) + 1

top_five = sorted(counts.items(), key=lambda x: x[1], reverse=True)[:5]
for rank, (word, freq) in enumerate(top_five, start=1):
    print(f"{rank}. {word} — {freq} times")